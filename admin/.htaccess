# ========================================================
# MARKETCODE - Admin Clean URLs & Subroute Configuration
# ========================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /admin/

    # 1. Chuyển hướng 301 nếu người dùng truy cập trực tiếp có đuôi .php sang Clean URL
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /admin/index\.php [NC]
    RewriteRule ^index\.php$ /admin/ [R=301,L]

    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /admin/([^.]+)\.php [NC]
    RewriteRule ^([^.]+)\.php$ $1 [R=301,L]

    # 2. Alias đặc biệt cho deposits -> transactions
    RewriteRule ^deposits/?$ transactions.php [L,QSA]

    # 3. Ánh xạ các trang quản trị chính
    RewriteRule ^categories/?$ categories.php [L,QSA]
    RewriteRule ^products/?$ products.php [L,QSA]
    RewriteRule ^orders/?$ orders.php [L,QSA]
    RewriteRule ^transactions/?$ transactions.php [L,QSA]
    RewriteRule ^users/?$ users.php [L,QSA]
    RewriteRule ^settings/?$ settings.php [L,QSA]

    # 4. Tự động ánh xạ Clean URLs sang file .php tương ứng nếu file tồn tại
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>
